# Copia a .env y ajusta. Las variables EXPO_PUBLIC_* se incrustan en el bundle: NUNCA pongas secretos aquí.

# IP LAN de tu PC (ipconfig → adaptador Wi-Fi). Es opcional: si no la pones, la app usa la IP desde la que Expo sirve el bundle.
EXPO_PUBLIC_API_URL=http://192.168.1.50:4000

# Opcional. Si no lo defines: Expo Go usa exp://IP:PUERTO/--/callback y un development build usa unisabana-auth://callback
# EXPO_PUBLIC_REDIRECT_URI=unisabana-auth://callback
